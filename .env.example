# AutoBrowser configuration template.
#
# Copy to `.env` (git-ignored) and uncomment what you want to change. Every
# field is already set to the value shown, so a verbatim copy is a no-op.
# Names follow AUTOBROWSER_<SECTION>__<FIELD>; src/config.py is the source of
# truth for every field, its bounds and its description. A real environment
# variable always outranks this file.
#
# A YAML file named by AUTOBROWSER_CONFIG_FILE outranks this file and the
# environment for the fields it sets; see config.example.yaml.
#
# Windows paths: use forward slashes. python-dotenv decodes escape sequences
# inside double-quoted values, so "C:\temp" silently becomes a tab character.
# Forward slashes are safe under every quoting style.
#
# An empty value (AUTOBROWSER_X=) means "not set" and leaves the default alone.

# --- LLM ---------------------------------------------------------------------

# Wire protocol of the chat model: ollama (/api/chat, the default) or
# openai_compat (any OpenAI Chat Completions service: OpenAI, aggregators, LM
# Studio, vLLM, Ollama's /v1). Service profiles are in config.example.yaml.
# AUTOBROWSER_LLM__PROVIDER=ollama

# Chat model id, as the provider expects it.
# AUTOBROWSER_LLM__MODEL=gemma4:31b-cloud

# Sampling temperature; 0.0 is deterministic. Range: 0.0-2.0. `null` sends no
# temperature at all (reasoning models such as gpt-5.x reject the parameter).
# AUTOBROWSER_LLM__TEMPERATURE=0.0

# Provider base URL. Required for openai_compat (the service's .../v1 URL;
# OPENAI_BASE_URL is not read). For ollama leave unset to let the client decide:
# it falls back to OLLAMA_HOST, then to a local daemon on the default port.
# AUTOBROWSER_LLM__HOST=

# Sent to the provider as an `Authorization: Bearer` header; without a key no
# such header is sent (local servers). OPENAI_API_KEY is not read. Required for
# hosted Ollama cloud models such as gpt-oss:20b-cloud.
# AUTOBROWSER_LLM__API_KEY=

# Timeout of one HTTP call to the provider, in seconds (both providers). `null`
# waits forever, the old Ollama behaviour, for slow local models on a CPU.
# AUTOBROWSER_LLM__TIMEOUT_SECONDS=60.0

# openai_compat: client retries on connection errors and 408/409/429/5xx.
# Range: 0-10. 0 keeps one model call within LOOP__PROGRESS_TIMEOUT_SECONDS;
# `doctor` warns when timeout x (retries + 1) reaches that budget.
# AUTOBROWSER_LLM__MAX_RETRIES=0

# How much reasoning to spend. One of: minimal, low, medium, high. Leave unset to
# let the provider choose. Sent by openai_compat; declarative for ollama.
# AUTOBROWSER_LLM__REASONING_EFFORT=

# Cap on generated output tokens, reasoning included for providers that do not
# budget it separately: num_predict for ollama, the field named by
# MAX_TOKENS_PARAM for openai_compat. Leave unset for no cap.
# AUTOBROWSER_LLM__MAX_OUTPUT_TOKENS=

# openai_compat: request field carrying MAX_OUTPUT_TOKENS. One of:
# max_completion_tokens, max_tokens (older servers and some models).
# AUTOBROWSER_LLM__MAX_TOKENS_PARAM=max_completion_tokens

# Cap on reasoning/thinking tokens specifically, for providers that budget them
# apart from output tokens. Declarative: no adapter sends it; put a vendor
# equivalent into EXTRA_BODY. Leave unset for no cap.
# AUTOBROWSER_LLM__MAX_REASONING_TOKENS=

# openai_compat: `parallel_tool_calls` sent with tool requests. The engine runs
# one call per turn, so `false` saves tokens. Leave unset to send nothing (not
# every server accepts the parameter).
# AUTOBROWSER_LLM__PARALLEL_TOOL_CALLS=

# openai_compat: extra request headers, a JSON object, e.g.
# {"X-Title":"AutoBrowser"}. Values may be secrets: never logged, `doctor` prints
# the names only.
# AUTOBROWSER_LLM__EXTRA_HEADERS={}

# openai_compat: vendor fields merged into the request body, a JSON object.
# Keys with a typed field of their own (model, messages, tools, stream,
# temperature, max_tokens, max_completion_tokens, reasoning_effort,
# parallel_tool_calls) are rejected.
# AUTOBROWSER_LLM__EXTRA_BODY={}

# Characters of a provider error body quoted in the error message. Minimum 40.
# AUTOBROWSER_LLM__ERROR_PREVIEW_CHARS=300

# Price per 1M tokens by model id, a JSON object, for cost reports and money
# budgets, e.g. {"gemma4:31b-cloud":{"input_per_mtok":0.2,"output_per_mtok":0.6}}
# (cached_input_per_mtok optional). A model without a price has an unknown cost.
# AUTOBROWSER_LLM__PRICES={}

# Currency of the prices and of cost reports.
# AUTOBROWSER_LLM__CURRENCY=USD

# --- Model cascade -----------------------------------------------------------

# Tiers above the session model (tier 0): the agent starts on tier 0 and goes up
# one tier when it is stuck, never down within a task. Off: one tier, as without it.
# AUTOBROWSER_CASCADE__ENABLED=false

# The tiers above tier 0, cheapest first, a JSON list of at most 3; each names a
# model and may override provider, host, api_key, temperature, reasoning_effort,
# timeout_seconds and set a label (the rest is inherited from llm.*), e.g.
# [{"model":"gpt-oss:120b-cloud","label":"strong"}]. Easier in YAML.
# AUTOBROWSER_CASCADE__TIERS=[]

# Tier of the replay retarget call (stage 2), 0..len(tiers).
# AUTOBROWSER_CASCADE__RETARGET_TIER=0

# When the tier goes up: consecutive failed calls and replans on the current tier,
# a progress-guard block, an empty model answer (instead of ending the task).
# AUTOBROWSER_CASCADE__ESCALATE_AFTER_FAILURES=2
# AUTOBROWSER_CASCADE__ESCALATE_AFTER_REPLANS=1
# AUTOBROWSER_CASCADE__ESCALATE_ON_PROGRESS_BLOCK=true
# AUTOBROWSER_CASCADE__ESCALATE_ON_NO_ACTION=true

# --- Browser -----------------------------------------------------------------

# Path to the Chrome executable.
# AUTOBROWSER_BROWSER__CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Chrome profile directory reused across sessions.
# AUTOBROWSER_BROWSER__USER_DATA_DIR=C:/temp/chrome_debug_profile

# Chrome DevTools Protocol port. Range: 1-65535.
# AUTOBROWSER_BROWSER__CDP_PORT=9222

# Seconds to wait for the CDP port to accept connections.
# AUTOBROWSER_BROWSER__CDP_TIMEOUT_SECONDS=30.0

# How often the CDP port is probed while waiting for Chrome (and one probe's timeout).
# Range: >0-10.
# AUTOBROWSER_BROWSER__CDP_POLL_SECONDS=0.5

# Who runs the browser: cdp (the session starts Chrome and waits for its CDP port)
# or external (the MCP server launches its own browser, e.g. a stand in Docker; no
# MCP server may then use {cdp_port}/{cdp_endpoint}).
# AUTOBROWSER_BROWSER__LAUNCH=cdp

# Start Chrome with --headless=new (launch: cdp only).
# AUTOBROWSER_BROWSER__HEADLESS=false

# Further Chrome arguments after the headless flag, as JSON, e.g. ["--no-sandbox"]
# in a container (launch: cdp only).
# AUTOBROWSER_BROWSER__EXTRA_ARGS=[]

# --- Agent loop --------------------------------------------------------------

# Maximum number of TurnController turns per task. Range: 1-1000.
# AUTOBROWSER_LOOP__TURN_CAP=50

# Replans allowed before the loop stops as blocked.
# AUTOBROWSER_LOOP__MAX_REPLANS=3

# Failed tool calls in a row before the loop stops.
# AUTOBROWSER_LOOP__MAX_CONSECUTIVE_FAILURES=3

# Steps allowed without advancing the plan before replanning.
# AUTOBROWSER_LOOP__MAX_STEPS_WITHOUT_PLAN_ADVANCE=8

# Times the same tool call (same name and arguments) may return an identical
# result before a further identical call is blocked and the agent must replan.
# AUTOBROWSER_LOOP__MAX_INEFFECTIVE_ACTIONS=3

# Wall-clock budget for one goal/task, in seconds.
# AUTOBROWSER_LOOP__TASK_TIMEOUT_SECONDS=300.0

# Stall budget when a goal stream stops reporting progress. Clamped to
# AUTOBROWSER_LOOP__TASK_TIMEOUT_SECONDS.
# AUTOBROWSER_LOOP__PROGRESS_TIMEOUT_SECONDS=120.0

# Budget of one task: model calls (plan, turns, retargets, approval judge),
# input + output tokens, and money in LLM__CURRENCY (needs LLM__PRICES; not
# checked while a call's cost is unknown). Empty: no cap. Running out blocks the
# task with stop_reason budget_exhausted before the next model call.
# AUTOBROWSER_LOOP__MAX_TASK_MODEL_CALLS=
# AUTOBROWSER_LOOP__MAX_TASK_TOKENS=
# AUTOBROWSER_LOOP__MAX_TASK_COST=

# --- Observation -------------------------------------------------------------

# Characters of page content kept in the preview.
# AUTOBROWSER_OBSERVATION__MAX_CONTENT_PREVIEW_CHARS=1200

# Element refs retained per compiled observation.
# AUTOBROWSER_OBSERVATION__MAX_REFS_IN_OBSERVATION=25

# Recent tool calls rendered in the Action History context block.
# AUTOBROWSER_OBSERVATION__ACTION_HISTORY_LIMIT=12

# Characters of arguments/result kept per Action History entry.
# AUTOBROWSER_OBSERVATION__ACTION_HISTORY_PREVIEW_CHARS=200

# --- Memory ------------------------------------------------------------------

# Older tool outputs longer than this are compacted once a newer result of the
# same tool exists; shorter outputs are always kept.
# AUTOBROWSER_MEMORY__COMPACT_TOOL_OUTPUT_MIN_CHARS=1000

# With --compress-tools: characters kept of a tool message's summary or error, for
# every tool alike.
# AUTOBROWSER_MEMORY__COMPRESSED_TOOL_RESULT_CHARS=500

# (AUTOBROWSER_MEMORY__MAX_TOOL_MESSAGE_REFS was removed: it was never read. It is
# still accepted and ignored with a warning; delete it from your environment.)

# Ceiling on the characters of the conversation history; past it the oldest tool
# outputs become a [cleared] placeholder. 0 disables the budget.
# AUTOBROWSER_MEMORY__HISTORY_BUDGET_CHARS=0

# The newest tool outputs the history budget never clears.
# AUTOBROWSER_MEMORY__KEEP_RECENT_TOOL_RESULTS=3

# Finished tasks kept verbatim in the session history; older ones are folded into
# one digest message each. 0 keeps every task verbatim.
# AUTOBROWSER_MEMORY__KEEP_RECENT_TASKS=0

# Characters of the user request / final answer kept in a task digest.
# AUTOBROWSER_MEMORY__DIGEST_REQUEST_CHARS=300
# AUTOBROWSER_MEMORY__DIGEST_ANSWER_CHARS=500

# Load persistent memory files (<storage root>/<dir>/) into a Memory context block.
# AUTOBROWSER_MEMORY__PERSISTENT_ENABLED=false

# Memory directory, relative to the storage root.
# AUTOBROWSER_MEMORY__DIR=memory

# Lines / characters of the memory index rendered into the prompt.
# AUTOBROWSER_MEMORY__INDEX_MAX_LINES=200
# AUTOBROWSER_MEMORY__INDEX_MAX_CHARS=25000

# Characters of the first body line used as the index description of a file whose
# frontmatter has none.
# AUTOBROWSER_MEMORY__INDEX_DESCRIPTION_CHARS=120

# Characters of the whole Memory context block.
# AUTOBROWSER_MEMORY__BLOCK_MAX_CHARS=12000

# A body the Memory block budget would cut below this many characters is left out
# of the block instead of being shown as a stub.
# AUTOBROWSER_MEMORY__BLOCK_MIN_SECTION_CHARS=40

# Characters of one memory file (truncated on read, refused on write).
# AUTOBROWSER_MEMORY__FILE_MAX_CHARS=8000

# Register the memory_view / memory_write tools (needs PERSISTENT_ENABLED).
# AUTOBROWSER_MEMORY__TOOL_ENABLED=false

# Successful tasks that load an unverified entry before it becomes verified.
# AUTOBROWSER_MEMORY__PROMOTE_AFTER_SUCCESSES=2

# Consecutive blocked tasks that load an entry before it becomes stale.
# AUTOBROWSER_MEMORY__STALE_AFTER_FAILURES=2

# A verified entry older than this many days renders as stale. 0 disables the TTL.
# AUTOBROWSER_MEMORY__STALE_AFTER_DAYS=90

# After a done task, ask the model for up to CONSOLIDATION_MAX_ENTRIES memory
# entries (unverified).
# AUTOBROWSER_MEMORY__CONSOLIDATE_ON_GOAL_END=false

# Ceiling on the consolidation model call, in seconds.
# AUTOBROWSER_MEMORY__CONSOLIDATION_TIMEOUT_SECONDS=30.0

# Entries one consolidation call may write.
# AUTOBROWSER_MEMORY__CONSOLIDATION_MAX_ENTRIES=3

# Characters of each consolidation prompt field (task, final answer, action journal).
# AUTOBROWSER_MEMORY__CONSOLIDATION_FIELD_CHARS=4000

# Characters of a reason, detail or path recorded in a memory.* event.
# AUTOBROWSER_MEMORY__EVENT_REASON_CHARS=300

# Characters of the model's working notes kept for the current task. 0 disables them.
# AUTOBROWSER_MEMORY__WORKING_NOTES_MAX_CHARS=0

# --- Skills ------------------------------------------------------------------

# Show the skill catalog, register the skill_view tool and read your skills.
# Always-on built-in skills (the browser rules) work without it.
# AUTOBROWSER_SKILLS__ENABLED=false

# Folder of your skills (one sub-folder with a SKILL.md each), relative to the
# storage root.
# AUTOBROWSER_SKILLS__DIR=skills

# Skills read from one source (built-in, yours); the rest are skipped.
# AUTOBROWSER_SKILLS__MAX_SKILLS=100

# Characters of the Skills catalog block and of one description in it.
# AUTOBROWSER_SKILLS__CATALOG_MAX_CHARS=4000
# AUTOBROWSER_SKILLS__DESCRIPTION_MAX_CHARS=1024

# Characters skill_view returns for a skill body / a skill file (a longer
# SKILL.md is not loaded).
# AUTOBROWSER_SKILLS__BODY_MAX_CHARS=20000
# AUTOBROWSER_SKILLS__FILE_MAX_CHARS=20000

# Characters of an always-on skill body, put into every system prompt; a longer
# one is not loaded.
# AUTOBROWSER_SKILLS__ALWAYS_MAX_CHARS=12000

# --- Replay ------------------------------------------------------------------

# Record completed runs (--record, /record) and replay recordings without the
# model (-p --recording, autobrowser recordings).
# AUTOBROWSER_REPLAY__ENABLED=false

# Folder of the recordings, relative to the storage root.
# AUTOBROWSER_REPLAY__DIR=recordings

# Steps of one recording; a longer run is not recorded.
# AUTOBROWSER_REPLAY__MAX_STEPS=100

# Lowest similarity (0..1) of a replayed step's output to the recorded one, and
# what of the page URL must match (path, host, off), before the agent takes over.
# AUTOBROWSER_REPLAY__CHECKPOINT_MIN_SIMILARITY=0.6
# AUTOBROWSER_REPLAY__CHECKPOINT_URL=path

# Ancestor lines kept in a recorded element descriptor (0..10).
# AUTOBROWSER_REPLAY__DESCRIBE_CONTEXT_LINES=2

# Words per shingle in the fingerprint of a non-browser tool output (1..10).
# AUTOBROWSER_REPLAY__TEXT_SHINGLE_WORDS=3

# Let a model retarget one diverged step before the agent takes over; retargeted
# steps per task, page characters sent, and the call timeout.
# AUTOBROWSER_REPLAY__RETARGET_ENABLED=true
# AUTOBROWSER_REPLAY__MAX_RETARGETS_PER_RUN=3
# AUTOBROWSER_REPLAY__RETARGET_CONTEXT_CHARS=12000
# AUTOBROWSER_REPLAY__RETARGET_TIMEOUT_SECONDS=30.0

# How a new recording answers after its steps: agent, output, summary.
# AUTOBROWSER_REPLAY__DEFAULT_ANSWER=agent

# Keep the replaced recording as previous.json.
# AUTOBROWSER_REPLAY__KEEP_PREVIOUS=true

# Characters of a divergence detail or a skip reason in replay events.
# AUTOBROWSER_REPLAY__DETAIL_MAX_CHARS=300

# Case-insensitive regex over the accessible name of a text-entry field: a recorded
# step typing into a matching field keeps no typed value. Empty: key-based only.
# AUTOBROWSER_REPLAY__SECRET_FIELD_PATTERN=(?<![a-zа-яё])(password|passcode|passphrase|pin|pin code|cvv|cvc|security code|card number|one-time code|secret|api key|access token|пароль|пин-код|пин)(?![a-zа-яё])

# --- Events ------------------------------------------------------------------

# Longest string preserved in a persisted event payload.
# AUTOBROWSER_EVENTS__MAX_STRING_CHARS=20000

# Longest text preserved in agent_trace.jsonl entries.
# AUTOBROWSER_EVENTS__AGENT_TRACE_MAX_TEXT_CHARS=500

# --- Storage -----------------------------------------------------------------

# Root directory for all runtime artifacts (sessions, memory, logs, input history);
# treat exporters as read-only over it. Empty = the AutoBrowser home (AUTOBROWSER_HOME,
# else ~/.autobrowser); a relative path is relative to the home.
# AUTOBROWSER_STORAGE__ROOT_DIR=

# Write <session>/state.json after every task (dialogue + page state, not redacted) so
# --continue / --resume can pick the session up later.
# AUTOBROWSER_STORAGE__PERSIST_STATE=true
# AUTOBROWSER_STORAGE__SESSIONS_SUBDIR=sessions
# AUTOBROWSER_STORAGE__BATCHES_SUBDIR=batches
# AUTOBROWSER_STORAGE__WORKSPACE_SUBDIR=workspace

# --- Flags -------------------------------------------------------------------

# Inert. The engine-native loop is the only runtime; parsed for CLI/env
# compatibility only and does not change routing.
# AUTOBROWSER_FLAGS__AGENT_LOOP=false

# --- Hooks -------------------------------------------------------------------

# Deterministic lifecycle hooks around the agent loop (src/harness/hooks.py).
# Disabled by default; handlers are Python import paths, so keep the registry in
# a git-ignored config.yaml rather than here.
# AUTOBROWSER_HOOKS__ENABLED=false

# Completions a stop hook may reject per task before done is accepted anyway.
# AUTOBROWSER_HOOKS__MAX_STOP_BLOCKS=2

# Timeout of a hook without its own timeout_seconds. Must stay below
# loop.progress_timeout_seconds.
# AUTOBROWSER_HOOKS__DEFAULT_TIMEOUT_SECONDS=10.0

# Command hooks: characters of a failed run's stderr kept in the error (0..20000), and
# the wait for a timed-out process tree to exit (0 < s <= 60). Command hooks run in the
# repository checkout, so relative script paths start there.
# AUTOBROWSER_HOOKS__COMMAND_STDERR_TAIL_CHARS=300
# AUTOBROWSER_HOOKS__COMMAND_KILL_WAIT_SECONDS=2.0

# Hooks run sequentially in this order per event (JSON list of hook specs; see
# config.example.yaml for the shape).
# AUTOBROWSER_HOOKS__REGISTRY=[]

# --- Permissions -------------------------------------------------------------

# Deterministic tool authorization (src/harness/permissions.py).
# default | read_only | dont_ask | bypass. dont_ask turns every approval into a
# deny; bypass grants approvals but deny rules and always_ask still hold.
# AUTOBROWSER_PERMISSIONS__MODE=default

# Permission rules (JSON list; see config.example.yaml for the shape and for
# opt-in examples such as page JavaScript or file upload). No rule ships with the
# code: without rules nothing asks. Prefer the YAML file: a list set here
# replaces, not extends, the one below it.
# AUTOBROWSER_PERMISSIONS__RULES=[]

# Who besides the rules may ask you to approve a state-changing call:
# off | model | classifier | both. model: the acting model fills an
# approval_request argument on tools without readOnlyHint. classifier: a separate
# model call judges each such call the rules let through. Their asks are
# always_ask; a classifier failure asks too.
# AUTOBROWSER_PERMISSIONS__APPROVAL_JUDGE=off

# Chat model of the approval classifier; empty reuses the session model.
# AUTOBROWSER_PERMISSIONS__CLASSIFIER_MODEL=

# How long one classifier call may take before the call is asked about anyway.
# AUTOBROWSER_PERMISSIONS__CLASSIFIER_TIMEOUT_SECONDS=30.0

# Sampling temperature of a separate CLASSIFIER_MODEL. Range: 0.0-2.0. `null`
# takes LLM__TEMPERATURE; with LLM__TEMPERATURE=null none is sent at all.
# AUTOBROWSER_PERMISSIONS__CLASSIFIER_TEMPERATURE=0.0

# How many characters of the call's JSON arguments and of the tool description the
# classifier sees (longer text is clipped with "...").
# AUTOBROWSER_PERMISSIONS__CLASSIFIER_ARGS_CHARS=1500
# AUTOBROWSER_PERMISSIONS__CLASSIFIER_DESCRIPTION_CHARS=400

# Values of the model's approval_request argument (lower-cased, JSON list) that
# mean "no approval needed".
# AUTOBROWSER_PERMISSIONS__APPROVAL_FALSE_WORDS=["", "false", "no", "none", "null", "0"]

# Share of AUTOBROWSER_LOOP__PROGRESS_TIMEOUT_SECONDS you may take to answer an
# approval (0 < ratio < 1); no answer in time is a deny.
# AUTOBROWSER_PERMISSIONS__APPROVAL_TIMEOUT_RATIO=0.8

# Characters of the call's JSON arguments shown in an approval question (20..20000).
# AUTOBROWSER_PERMISSIONS__APPROVAL_ARGS_PREVIEW_CHARS=300

# --- UI ----------------------------------------------------------------------

# Interactive front end: auto (terminal UI when the terminal supports it, else
# plain) | tui | plain | classic (the cmd2 REPL).
# AUTOBROWSER_UI__FRONTEND=auto

# inline: the transcript flows into the normal terminal scrollback.
# AUTOBROWSER_UI__SCREEN=inline

# Palette: dark | light | mono. Colour depth: auto | truecolor | 256 | 16 | none
# (NO_COLOR in the environment means none). Glyphs: auto | unicode | ascii.
# AUTOBROWSER_UI__THEME=dark
# AUTOBROWSER_UI__COLOR=auto
# AUTOBROWSER_UI__GLYPHS=auto

# Welcome banner; empty line between blocks (comfortable | compact); collapsed
# (compact) or expanded (verbose) tool calls.
# AUTOBROWSER_UI__BANNER=true
# AUTOBROWSER_UI__DENSITY=comfortable
# AUTOBROWSER_UI__DETAIL=compact

# Result lines shown in verbose detail (0..50) and preview characters of tool
# arguments and results (40..20000).
# AUTOBROWSER_UI__PREVIEW_LINES=3
# AUTOBROWSER_UI__PREVIEW_CHARS=400

# Live zone height limit (4..60 lines) and its redraw rate (1..30 per second).
# AUTOBROWSER_UI__LIVE_MAX_LINES=12
# AUTOBROWSER_UI__REFRESH_HZ=10.0

# Synchronized output (DEC 2026) around frames: auto | on | off.
# AUTOBROWSER_UI__SYNC_OUTPUT=auto

# Keys: lone-Esc delay (0..1000 ms), window of a repeated Ctrl+C / Ctrl+D
# (0.2..3.0 s), terminal size polling (0.1..5.0 s; Windows has no SIGWINCH).
# AUTOBROWSER_UI__ESCAPE_TIMEOUT_MS=50
# AUTOBROWSER_UI__DOUBLE_PRESS_SECONDS=0.8
# AUTOBROWSER_UI__SIZE_POLL_SECONDS=0.5

# Render the final answer as markdown.
# AUTOBROWSER_UI__MARKDOWN=true

# Input history kept between runs in <storage.root_dir>/input_history (plain text: what
# you type is stored as is, secrets included), and its size (0..100000 entries).
# AUTOBROWSER_UI__INPUT_HISTORY=true
# AUTOBROWSER_UI__INPUT_HISTORY_SIZE=1000

# Ring the bell and set the window title when an approval is asked.
# AUTOBROWSER_UI__APPROVAL_BELL=false

# Interface language: ru | en.
# AUTOBROWSER_UI__LOCALE=ru

# Default output format of print mode (-p): text | json | stream-json.
# AUTOBROWSER_UI__PRINT_FORMAT=text

# Log of logging records, warnings and child-process stderr while the terminal UI
# or print mode owns the terminal; a relative path is under the storage root.
# AUTOBROWSER_UI__LOG_FILE=logs/autobrowser.log

# Session event stream: events kept for late subscribers (100..100000) and events
# queued for one slow subscriber before it gets a gap marker (10..100000).
# AUTOBROWSER_UI__EVENT_BUFFER_SIZE=2000
# AUTOBROWSER_UI__SUBSCRIBER_QUEUE_SIZE=1000

# Status line polling (0.2..60 s) and how long stopping a task, the session loop
# or a client may take (0.5..60 s).
# AUTOBROWSER_UI__STATUS_INTERVAL_SECONDS=1.0
# AUTOBROWSER_UI__SHUTDOWN_TIMEOUT_SECONDS=5.0

# Timeout of each external check of `autobrowser doctor` (node/npx --version; 0..120 s).
# AUTOBROWSER_UI__DOCTOR_PROBE_TIMEOUT_SECONDS=10.0

# Sessions offered by --resume without an id (1..1000).
# AUTOBROWSER_UI__RESUME_LIST_SIZE=20

# --- Pipeline ----------------------------------------------------------------
# Read only by the eval/regression tools, never by the agent runtime. scripts/run_evals.py
# runs hermetically: it hides config files and .env, and reads only these variables
# from the real environment.

# Accepted relative change of an eval's request_chars against the baseline (0..10):
# more growth is a regression, a bigger drop an improvement.
# AUTOBROWSER_PIPELINE__REQUEST_CHARS_TOLERANCE=0.1

# Rows kept in the batch run history (<storage.batches_dir>/history.jsonl, one row per
# scenario per run, 100..10000000); past it the oldest rows are dropped.
# AUTOBROWSER_PIPELINE__HISTORY_MAX_ROWS=50000

# Accepted relative growth of a scenario's duration, model calls or input tokens between
# two batch runs in scripts/compare_batches.py (0..10); more is a slower/costlier finding.
# AUTOBROWSER_PIPELINE__BATCH_METRIC_TOLERANCE=0.25

# --- Telemetry ---------------------------------------------------------------
# OpenTelemetry trace export over OTLP/HTTP (needs `uv sync --group otel`). Off by
# default; nothing leaves the machine unless it is enabled. See docs/development/telemetry.md.

# Export every session's tasks as spans.
# AUTOBROWSER_TELEMETRY__OTLP_ENABLED=false

# OTLP/HTTP traces URL; the default is the standard local OTLP port. A hosted backend
# names its own, e.g. Langfuse Cloud: https://cloud.langfuse.com/api/public/otel/v1/traces
# AUTOBROWSER_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Request headers as a JSON object, e.g. {"Authorization": "Basic <base64 of key:secret>"}.
# AUTOBROWSER_TELEMETRY__OTLP_HEADERS={}

# Timeout of one export request and of the flush at session end (1..120 s).
# AUTOBROWSER_TELEMETRY__OTLP_TIMEOUT_SECONDS=10.0

# none: only ids, names, counts, statuses, durations. redacted: also task text, answers
# and tool arguments/results after event redaction -- they leave the machine.
# AUTOBROWSER_TELEMETRY__CAPTURE_CONTENT=none

# The task's steps (tool calls, gate decisions, outcome) as one JSON object on its task span
# (autobrowser.trajectory), for evaluators that read one observation only. Langfuse: alias it
# to langfuse.observation.metadata (see ATTRIBUTE_ALIASES).
# AUTOBROWSER_TELEMETRY__TRAJECTORY=false

# service.name resource attribute of the spans.
# AUTOBROWSER_TELEMETRY__SERVICE_NAME=autobrowser

# deployment.environment.name on every span (e.g. interactive); unset: none. Batch runs
# label their sessions "batch", which wins over this value.
# AUTOBROWSER_TELEMETRY__ENVIRONMENT=

# Copy span attribute A also under key B (JSON object), for a backend that reads its own
# keys. Langfuse: filters by batch/scenario and the commit as release:
# {"autobrowser.batch.id": "langfuse.trace.metadata.batch_id",
#  "autobrowser.scenario.id": "langfuse.trace.metadata.scenario_id",
#  "vcs.ref.head.revision": "langfuse.release",
#  "autobrowser.trajectory": "langfuse.observation.metadata"}
# AUTOBROWSER_TELEMETRY__ATTRIBUTE_ALIASES={}

# --- Evaluation platform -----------------------------------------------------
# Batch results as datasets, experiments and scores (scripts/langfuse_sync.py,
# run_batch.py). Off by default; read only by the developer scripts and `doctor`.
# See docs/development/eval-platform.md.

# Sync batch results to the platform.
# AUTOBROWSER_EVAL_PLATFORM__ENABLED=false

# Base URL, no trailing slash; no default. Langfuse Cloud EU: https://cloud.langfuse.com
# (US: https://us.cloud.langfuse.com).
# AUTOBROWSER_EVAL_PLATFORM__HOST=

# Project keys (pk-lf-... / sk-lf-...); secrets, never logged.
# AUTOBROWSER_EVAL_PLATFORM__PUBLIC_KEY=
# AUTOBROWSER_EVAL_PLATFORM__SECRET_KEY=

# none: only repository data, ids, statuses, scores. answers: also final answers (they
# may quote pages). redacted: also tool arguments/results after event redaction.
# AUTOBROWSER_EVAL_PLATFORM__CAPTURE_CONTENT=none

# Dataset name prefix (folder): autobrowser/ -> autobrowser/golden.
# AUTOBROWSER_EVAL_PLATFORM__DATASET_PREFIX=autobrowser/

# Environment of the experiment traces and scores ([a-z0-9_-], up to 40).
# AUTOBROWSER_EVAL_PLATFORM__ENVIRONMENT=batch

# run_batch.py syncs the batch right after it ends (when enabled), within this budget.
# AUTOBROWSER_EVAL_PLATFORM__AUTO_SYNC=true
# AUTOBROWSER_EVAL_PLATFORM__SYNC_TIMEOUT_SECONDS=300.0

# One HTTP request: timeout, retries on 429/5xx/network, backoff base without Retry-After.
# AUTOBROWSER_EVAL_PLATFORM__TIMEOUT_SECONDS=30.0
# AUTOBROWSER_EVAL_PLATFORM__MAX_RETRIES=3
# AUTOBROWSER_EVAL_PLATFORM__RETRY_BACKOFF_SECONDS=2.0

# Client rate limit of REST requests (Cloud Hobby allows 30/min).
# AUTOBROWSER_EVAL_PLATFORM__REQUESTS_PER_MINUTE=25

# Scores per request; size limit of one trace request (a larger trace is split).
# AUTOBROWSER_EVAL_PLATFORM__SCORE_BATCH_SIZE=100
# AUTOBROWSER_EVAL_PLATFORM__MAX_REQUEST_BYTES=4000000

# Wait before an experiment trace of unknown fate may be sent again.
# AUTOBROWSER_EVAL_PLATFORM__VERIFY_GRACE_SECONDS=60.0

# Annotation queue for failed scenarios (unset: off), which failure kinds go there (JSON
# list) and how many per batch.
# AUTOBROWSER_EVAL_PLATFORM__TRIAGE_QUEUE=
# AUTOBROWSER_EVAL_PLATFORM__TRIAGE_KINDS=["permission_denied", "guard_limit", "agent_stopped", "grade_failed", "error", "ungraded"]
# AUTOBROWSER_EVAL_PLATFORM__TRIAGE_MAX_ITEMS=50

# --- Serve (autobrowser serve) -----------------------------------------------
# The stand: jobs run by triggers, without a terminal. Nothing runs unless the
# command is started. See docs/development/serve-mode.md. Jobs are easier to
# write in YAML (serve.jobs in config.yaml or AUTOBROWSER_CONFIG_FILE).

# Address and port of the HTTP API. A host other than 127.0.0.1, ::1 or
# localhost needs SERVE__ALLOW_REMOTE=true and a non-empty SERVE__TOKEN.
# AUTOBROWSER_SERVE__HOST=127.0.0.1
# AUTOBROWSER_SERVE__PORT=8765

# Bearer token of /v1/*; empty: /v1/* answers 401. Never logged.
# AUTOBROWSER_SERVE__TOKEN=

# Allow a remote host (e.g. 0.0.0.0 inside a container).
# AUTOBROWSER_SERVE__ALLOW_REMOTE=false

# Stand files (ledger, events, job state) and worker browser profiles, both
# under STORAGE__ROOT_DIR.
# AUTOBROWSER_SERVE__DIR=serve
# AUTOBROWSER_SERVE__PROFILES_DIR=serve/profiles

# Workers running jobs in parallel (1..8): each has its own session, browser, MCP
# processes, profile PROFILES_DIR/w<i> and CDP port CDP_PORT_BASE + i. More than one
# needs MEMORY__PERSISTENT_ENABLED=false.
# AUTOBROWSER_SERVE__WORKERS=1

# CDP port of worker w0 when BROWSER__LAUNCH=cdp (w<i>: base + i). Range: 1-65535.
# AUTOBROWSER_SERVE__CDP_PORT_BASE=9300

# Queued runs at most; a trigger beyond it is skipped (queue_full).
# AUTOBROWSER_SERVE__QUEUE_SIZE=20

# A trigger on a busy job: drop it, or keep one waiting (queue_one).
# AUTOBROWSER_SERVE__COALESCE=drop

# Least seconds between the end of a job's run and its next start.
# AUTOBROWSER_SERVE__COOLDOWN_SECONDS=0.0

# Least period of a trigger, in seconds (>= 1).
# AUTOBROWSER_SERVE__MIN_INTERVAL_SECONDS=60.0

# Missed cron slots after downtime: none, or one catch-up run.
# AUTOBROWSER_SERVE__CATCH_UP=none

# IANA zone of cron schedules and day budgets; empty: the system zone (on
# Windows an IANA name needs the tzdata package).
# AUTOBROWSER_SERVE__TIMEZONE=

# Day budgets (runs, tokens, money in LLM__CURRENCY). Empty: no cap. A run
# beyond them is skipped and one budget notification is sent per day.
# AUTOBROWSER_SERVE__DAILY_MAX_RUNS=
# AUTOBROWSER_SERVE__DAILY_MAX_TOKENS=
# AUTOBROWSER_SERVE__DAILY_MAX_COST=

# Budget of a run without its own, as JSON; max_model_calls is required.
# AUTOBROWSER_SERVE__DEFAULT_RUN_BUDGET={"max_model_calls": 30}

# Ladder cap of a run without its own: probe, playback, retarget, agent, human
# (human only with SERVE__API_APPROVALS).
# AUTOBROWSER_SERVE__DEFAULT_MAX_STAGE=agent

# Runs before the worker's session (browser, MCP) is recreated.
# AUTOBROWSER_SERVE__SESSION_MAX_RUNS=200

# Seconds a running run may finish on shutdown before it is cancelled.
# AUTOBROWSER_SERVE__SHUTDOWN_GRACE_SECONDS=60.0

# Requests per minute per token, webhook trigger or failing client.
# AUTOBROWSER_SERVE__RATE_LIMIT_PER_MINUTE=60

# Largest request body in bytes (>= 1024).
# AUTOBROWSER_SERVE__MAX_BODY_BYTES=65536

# Seconds an Idempotency-Key is remembered.
# AUTOBROWSER_SERVE__IDEMPOTENCY_WINDOW_SECONDS=3600.0

# Accept free-form tasks on POST /v1/tasks, and their task scope (JSON list;
# empty: none).
# AUTOBROWSER_SERVE__FREE_TASKS=false
# AUTOBROWSER_SERVE__FREE_TASK_DOMAINS=[]

# Answer approvals on POST /v1/approvals/{id}; off: approvals are denied.
# AUTOBROWSER_SERVE__API_APPROVALS=false

# Write client addresses into the stand events.
# AUTOBROWSER_SERVE__LOG_CLIENT_ADDRESSES=false

# Notification channels, as JSON: log, webhook (needs WEBHOOK_OUT), telegram
# (needs TELEGRAM).
# AUTOBROWSER_SERVE__CHANNELS=["log"]

# Longest notification body (>= 100).
# AUTOBROWSER_SERVE__NOTIFY_MAX_CHARS=1500

# The outgoing webhook channel; set its fields as
# AUTOBROWSER_SERVE__WEBHOOK_OUT__URL, __SECRET (HMAC key), __TIMEOUT_SECONDS.
# AUTOBROWSER_SERVE__WEBHOOK_OUT=

# The Telegram channel (long polling, no inbound port); set its fields as
# AUTOBROWSER_SERVE__TELEGRAM__BOT_TOKEN (a secret: keep it here, not in a profile),
# __ALLOWED_CHAT_IDS (JSON list), __API_BASE (empty: the public Bot API), __APPROVALS,
# __POLL_TIMEOUT_SECONDS, __REQUEST_TIMEOUT_SECONDS, __POLL_BACKOFF_SECONDS,
# __POLL_BACKOFF_MAX_SECONDS, __SEND_RETRY_MAX_SECONDS, __MAX_UPDATE_AGE_SECONDS.
# AUTOBROWSER_SERVE__TELEGRAM=

# The jobs, as JSON (write them in YAML instead).
# AUTOBROWSER_SERVE__JOBS={}
