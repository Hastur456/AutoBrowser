# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Settings profiles: a copy of config.example.yaml may hold llm.api_key, so the
# conventional names are ignored by default. To commit a shared, non-secret
# profile, give it a name of your own (and add it with `git add -f` if it
# matches a pattern here).
config.yaml
config.local.yaml
config.local.yml
secrets.yaml

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# AI tools and agents local data
.codex-lb/
.agents/
.specstory/
.cursorignore

# Individual
profile/
baseline/
node_modules/
.codegraph/
.playwright-mcp/
.autobrowser/
test.py
extra/
exports/
.claude/
plans/
